{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Notion__notion-delete-.*|mcp__Notion__notion-calendar-cancel-events|mcp__Google_Calendar__delete_event|mcp__Google_Drive__trash_file|mcp__github__delete_file",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-delete.sh"
          }
        ]
      },
      {
        "matcher": "mcp__Notion__notion-update-page|Artifact|mcp__claude-artifacts__delete_artifact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-delete-args.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-date.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/delete-gate-prompt.py"
          }
        ]
      }
    ]
  }
}
