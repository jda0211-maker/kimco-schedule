{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Notion__notion-delete-.*|mcp__Notion__notion-calendar-cancel-events|mcp__Google_Calendar__delete_event|mcp__Google_Drive__trash_file|mcp__github__delete_file",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-delete.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-date.sh" }
        ]
      }
    ]
  }
}
